# langs/php.lang -- php syntax support for Mied.

Language php {
    extensions    {.php .php3 .php4 .php5 .phtml .phps}
    shebang       php
    line_comment  //
}

HighlightClass  keywords        keyword  {
    abstract and array as break callable case catch class clone const
    continue declare default do echo else elseif empty enddeclare endfor
    endforeach endif endswitch endwhile enum eval exit extends final
    finally fn for foreach function global goto if implements include
    include_once instanceof insteadof interface isset list match namespace
    new or print private protected public readonly require require_once
    return static switch throw trait try unset use var while xor yield
}

HighlightClass  builtins        punct    {
    true false null int float bool string object mixed void iterable
    callable self parent this
}

HighlightRegexp tags            preproc  {<\?(php\y|=|[[:space:]]|$)|\?>}
HighlightRegexp comments        comment  {//[^\n\r]*}
HighlightRegexp hash_comments   comment  {#[^\n\r]*}
HighlightRegexp block_comments  comment  {/\*([^*]|\*[^/])*\*/}
HighlightRegexp strings         string   {"(\\.|[^"\\])*"}
HighlightRegexp squote          string   {'(\\.|[^'\\])*'}
HighlightRegexp variables       punct    {\$[[:alnum:]_]+}
HighlightRegexp numbers         number   {\m(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][-+]?[0-9]+)?)\M}
HighlightChars  punct           punct    {()[]{};,.:=*+-/<>!&|^%~?@}
